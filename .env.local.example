# Copy this file to .env.local before running the app.
# NEVER commit real secrets - .env.local is gitignored.

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Required for every AI feature: resume parsing, job matching, question
# generation, answer generation, the Verified Experience Layer's claim-level
# validation, and both mock and live interviews.
# Without it the app still runs - navigation, uploads, and the knowledge base
# all work - but any AI action returns a clear "key not set" message instead.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Local-first database file (swap to a Postgres/Supabase URL later).
DATABASE_PATH=./data/app.db
